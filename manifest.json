{
    "manifest_version": 3,
    "name": "Edu CSS",
    "short_name": "Edu CSS",
    "description": "Font fix for edu.gosuslugi.ru",
    "version": "0.1.0.0",
    "author": "Kirill Zotov",
    "action": {
        "default_icon": "icon.png",
        "default_title": "Edu CSS"
    },
    "content_scripts": [
        {
            "matches": [
                "https://edu.gosuslugi.ru/*"
            ],
            "css":[
                "css.css"
            ]
        }
    ]
}